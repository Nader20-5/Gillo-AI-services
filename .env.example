# MongoDB Configuration
MONGO_PORT=27017
MONGO_DB=gillo_ai
MONGO_URI=mongodb://localhost:27017/gillo_ai

# Service Configuration
SERVICE_NAME=gillo-ai-service
SERVICE_PORT=8000
ENVIRONMENT=development

# Core Agile Integration Mode (mock | live)
CORE_AGILE_MODE=mock
CORE_AGILE_API_URL=http://localhost:3000

# Security / Auth
JWT_SECRET=your_jwt_secret_here_must_be_at_least_32_chars
JWT_ALGORITHM=HS256

# Optional Third-Party LLM API Keys (placeholders only)
# GROQ_API_KEY=your_groq_api_key_here
# CLOUD_LLM_API_KEY=your_cloud_llm_api_key_here
