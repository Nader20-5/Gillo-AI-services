      }
    ],
    "learning_rate_sweep": [
      {
        "n_estimators": 200,
        "learning_rate": 0.01,
        "test_epic_mean": 19.99,
        "test_epic_median": 20.06
      },
      {
        "n_estimators": 200,
        "learning_rate": 0.05,
        "test_epic_mean": 21.08,
        "test_epic_median": 21.04
      },
      {
        "n_estimators": 200,
        "learning_rate": 0.1,
        "test_epic_mean": 21.94,
        "test_epic_median": 21.92
      },
      {
        "n_estimators": 200,
        "learning_rate": 0.2,
        "test_epic_mean": 22.5,
        "test_epic_median": 22.18
      }
    ],
    "tested": true,
    "finding": "Empirical testing confirms boosting shrinkage: LightGBM regression_l1 initializes all predictions at the global training median (3.0 SP). Because Epics represent a 1.9% minority class in training (576 / 29,906), each tree's L1 gradient step on Epics is bounded. At learning_rate = 0.05 and n_estimators = 200, the cumulative shrinkage (learning_rate x n_estimators = 10.0 nominal capacity) regularizes leaf values and halts the progression at ~21.04 SP before it can traverse the full distance from 3.0 to 24.0 SP. Increasing n_estimators to 800 or learning_rate to 0.20 drives predictions up to 22.3-22.5 SP, proving the ~21 level is an artifact of gradient shrinkage and finite boosting capacity, not an artificial cap."
  },
  "item6_model_selection": {
    "selection_log": {
      "rule": "Lowest VALIDATION MAE on Epic-excluded population; if difference < 0.02 MAE, choose simpler model (Type-only < TF-IDF < S-BERT).",
      "candidates_val_mae": {
        "type_only": 2.0704,
        "tfidf_type": 1.9099,
        "sbert_type": 1.9068
      },
      "comparison": {
        "difference_sbert_vs_tfidf": 0.0031,
        "threshold": 0.02,
        "is_diff_below_threshold": true
      },
      "selected_winner": "TF-IDF + Type",
      "rationale": "S-BERT + Type achieved lowest Validation MAE (1.9068), but TF-IDF + Type is only 0.0031 MAE behind (1.9099). Because 0.0031 < 0.02 threshold, the predeclared simplicity rule selects TF-IDF + Type as the deployment winner. Type-only (2.0704) was disqualified as it trailed by 0.1605 MAE (> 0.02)."
